{% set year = 0 %}{% for item in selected %}{% if item.data.year != year %}{% if not loop.first %}</div></div>{% endif %}<div class="columns"><div class="column is-2"><div class="content"><p class="pub-year is-size-2">{{ item.data.year }}</p></div></div><div class="column is-10">{% set year = item.data.year %}{% endif %}
<div class="columns is-mobile mt-0 mb-4"><div class="column is-11-tablet is-10-mobile"><div class="content"><h3 class="pub-title is-size-4 mb-1">{% if item.data.url %}<a href="{{ item.data.url }}" style="color:inherit">{{ item.data.title }}</a>{% else %}{{ item.data.title }}{% endif %}{% if item.data.featured %}<span class="tag is-danger is-light is-size-7 ml-2" style="transform:translateY(-12.5%)">Featured</span>{% endif %}</h3><div class="pub-links has-text-grey-light">{% for link in item.data.links %}<a href="{{ link.url }}" class="is-6 has-text-grey-light">{{ link.label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</div><div class="pub-info mt-4"><div class="pub-author mb-0">{{ item.data.authors }}</div><div class="pub-venue">{{ item.data.venue }}</div><div class="pub-description mt-2">{{ item.content | safe }}</div></div></div></div>{% if item.data.image %}<div class="column has-text-centered is-1-tablet is-2-mobile"><figure class="image is-48x48 mt-1"><img src="{{ item.data.image }}" alt=""></figure></div>{% endif %}</div>
{% else %}<p>No publications yet.</p>{% endfor %}{% if selected.length %}</div></div>{% endif %}
