---
layout: base.njk
---
<section class="hero mt-6 section-shadow"><div class="hero-body pb-4"><div class="container is-max-desktop px-5">
  <h1 class="site-title title mb-2 is-uppercase">{{ site.name }}</h1>
  <div class="columns mt-0 is-mobile"><div class="column is-8 pt-0 mt-0"><div class="columns mb-0 mt-0 is-multiline is-mobile"><div class="column is-12 pt-0 mt-0"><div class="tabs" style="transform:translateX(-1rem)"><ul>{% for link in socials %}<li><a href="{{ link.url }}" class="button is-white px-1" aria-label="{{ link.label }}"><i class="{{ link.icon }} has-text-grey" aria-hidden="true"></i>{% if link.label == 'CV' %}<span class="ml-1 has-text-grey">CV</span>{% endif %}</a></li>{% endfor %}</ul></div></div><div class="column is-12"><h2 class="subtitle site-subtitle is-size-4 mb-1">{{ site.tagline | safe }}</h2></div></div></div><div class="column is-4"><figure class="image portrait pt-6-mobile pt-3-tablet" style="max-width:128px"><img src="{{ site.portrait }}" alt="Portrait of {{ site.name }}"></figure></div></div>
  {% include "nav.njk" %}
</div></div></section>
<main id="main">
<section class="hero section-shadow"><div class="hero-body pb-0"><div class="container is-max-desktop px-5"><h5 class="tiny-section-header mb-6 mt-1" id="research">RESEARCH</h5><div class="columns"><div class="column is-12-mobile is-9-tablet is-9 pt-0"><div class="content is-family-secondary has-text-black-ter">{{ researchContent | markdown | safe }}<ul>{% for direction in directions %}<li><span class="research-filter-trigger" data-target-focus="{{ direction.focus }}" style="font-weight:600">{{ direction.title }}</span>: {{ direction.description }}</li>{% endfor %}</ul><p class="has-text-grey-lighter">Click on each headline to see featured projects below.</p></div></div></div>
<div class="content mt-0"><div class="carousel columns is-mobile pb-6 mt-0 mb-0 ml-0">{% for item in featuredProjects %}{% if item.featured %}<div class="column carousel-item pt-0 mt-2 mr-4" data-focus="{{ item.focus }}"><div class="card"><div class="card-content">{% if item.emoji %}<figure class="image is-32x32 mx-0 mb-2"><span role="img" aria-label="{{ item.title }} icon" style="font-size: 1.75rem; line-height: 1;">{{ item.emoji }}</span></figure>{% elif item.image %}<figure class="image is-32x32 mx-0 mb-2"><img src="{{ item.image }}" alt=""></figure>{% endif %}<p class="title is-size-5 is-family-secondary pub-title mb-1">{{ item.title }}</p><div class="is-flex is-align-items-center mb-3"><span class="is-size-7 has-text-grey is-family-secondary pr-2">{{ item.year }}</span><span class="is-size-7 is-family-secondary">{% for link in item.links %}<a href="{{ link.url }}" class="has-text-grey-light ml-2">{{ link.label }}</a>{% endfor %}</span></div><p class="is-6 is-family-secondary has-text-grey">{{ item.summary }}</p></div></div></div>{% endif %}{% endfor %}</div></div>
</div></div></section>
<section class="hero section-shadow"><div class="hero-body"><div class="container is-max-desktop px-5"><h5 class="tiny-section-header mb-6 mt-1" id="latest">LATEST</h5><div class="content is-family-secondary has-text-grey-dark mb-6">Check out the latest news about my <span class="update-block-trigger" data-target-update-type="news">research updates</span>, <span class="update-block-trigger" data-target-update-type="talk,teaching">talks &amp; lectures</span>, and more.<br><div class="is-hidden-tablet has-text-grey-lighter" style="transform:translateY(2.5rem);z-index:1;pointer-events:none">Scroll/drag right for more updates.</div></div><div class="content"><div class="columns"><div class="column is-6 update-section"><div class="columns my-0 py-0 is-mobile is-multiline scrollable-update-section-columns">{% for update in collections.updates %}<div class="column my-0 py-0 is-full-desktop is-half-mobile"><div class="content py-2 px-3 mb-2 update-block {% if loop.first %}is-active{% endif %}" data-update-id="{{ update.fileSlug }}" data-update-type="{{ update.data.kind }}"><div class="is-family-secondary mt-1"><span class="is-size-7 has-text-grey-light">{{ update.date | date('yyyy MMMM') }}</span></div><div class="is-size-6 is-italic"><span class="{% if update.data.kind == 'news' %}has-text-danger has-background-danger-light{% elif update.data.kind == 'talk' %}has-text-info has-background-info-light{% else %}has-text-success has-background-success-light{% endif %}">{{ update.data.label }}</span></div><h6 class="title is-family-secondary mb-2" style="line-height:145%">{{ update.data.title }}</h6></div></div>{% endfor %}</div></div><div class="column is-6">{% for update in collections.updates %}<div id="update-details-{{ update.fileSlug }}" class="update-details {% if not loop.first %}is-hidden{% endif %}">{% if update.data.image %}<figure class="image"><img src="{{ update.data.image }}" alt=""></figure>{% endif %}<div class="content is-family-secondary has-text-grey-dark mt-4">{{ update.content | safe }}</div></div>{% endfor %}</div></div></div></div></div></section>
<section class="hero section-shadow"><div class="hero-body"><div id="collapsibleSection" class="collapsible-section"><div class="container is-max-desktop px-5"><h5 class="tiny-section-header mb-6 mt-1" id="publications">PUBLICATIONS</h5><div class="tabs pb-4 mb-1 is-centered" data-tab-group="publication"><ul><li data-tab-target="#featured-pub"><a class="pl-3 pr-5">Featured</a></li><li class="is-active" data-tab-target="#pub-by-year"><a class="pl-3 pr-5">By year</a></li><li data-tab-target="#pub-by-theme"><a class="pr-3">By theme</a></li></ul></div><div id="featured-pub" class="tab-content" data-tab-group="publication">{% set selected = collections.publications | filterFeatured %}{% include "publication-list.njk" %}</div><div id="pub-by-year" class="tab-content is-active" data-tab-group="publication">{% set selected = collections.publications %}{% include "publication-list.njk" %}</div><div id="pub-by-theme" class="tab-content" data-tab-group="publication">{% for direction in directions %}<h3 class="pub-year is-size-2">{{ direction.title }}</h3>{% set selected = collections.publications | filterFocus(direction.focus) %}{% include "publication-list.njk" %}{% endfor %}</div></div></div><div class="has-text-centered"><button id="toggleButton" class="toggle-button show-more is-family-secondary">Show more</button></div></div></section>
<section class="hero section-shadow"><div class="hero-body"><div class="container is-max-desktop px-5"><h5 class="tiny-section-header mb-6 mt-1" id="projects">PROJECTS</h5><div class="content is-family-secondary has-text-grey-dark"><div class="content"><p>Besides research, I've worked on various projects and here are a few of them:</p></div><div class="scrollable-columns">{% for group in projects %}<div class="column"><h5 class="title is-5 pub-title">{{ group.group }}</h5>{% for project in group.items %}<div class="mb-5 pb-2"><h6 class="title"><a href="{{ project.url }}">{{ project.title }}</a></h6><div class="subtitle is-6 has-text-grey" style="transform:translateY(7.5%)">{{ project.description }}{% if project.codeUrl %} <a href="{{ project.codeUrl }}">Code</a>{% endif %}</div></div>{% endfor %}</div>{% endfor %}</div></div></div></div></section>
<section class="hero pb-6"><div class="hero-body"><div class="container is-max-desktop px-5"><h5 class="tiny-section-header mb-6 mt-1" id="contact">CONTACT</h5><div class="content is-family-secondary has-text-grey-dark"><p>Whenever you have any questions regarding my research (or just want to say hi), the best email address to find me is <a href="mailto:{{ site.email }}">{{ site.email }}</a>. You can also find me on <a href="{{ site.linkedin }}">LinkedIn</a> and <a href="{{ site.github }}">GitHub</a>.</p></div></div></div></section>
</main>
