---
layout: base.njk
---
<section class="hero pt-6 pb-2 section-shadow post-head"><div class="hero-body pb-5"><div class="container is-max-desktop px-5"><h1 class="post-title title mb-3">{{ title }}</h1><div class="mt-0 has-text-grey"><span>{{ page.date | date('dd MMM yyyy') }}</span>{% if readingTime %}<span class="mx-2">·</span><span>{{ readingTime }} min</span>{% endif %}<span class="mx-2">·</span><a href="/" class="has-text-grey">{{ site.shortName }}</a>{% if translationUrl %}<span class="mx-2">·</span><a href="{{ translationUrl }}" class="has-text-grey" hreflang="{% if lang == 'fr' %}en{% else %}fr{% endif %}">{% if lang == 'fr' %}English{% else %}Français{% endif %}</a>{% endif %}</div></div></div></section>
<main id="main"><section class="hero pb-0 mb-0"><div class="hero-body"><div class="container is-max-desktop px-5"><div class="columns"><div class="column is-10"><div class="content post-body">{{ content | safe }}</div></div></div></div></div></section><section class="hero section-shadow"><div class="hero-body"><div class="container is-max-desktop px-5"><a href="{% if articleType == 'news' %}/#latest{% else %}/{% if lang == 'fr' %}fr/{% endif %}posts/{% endif %}">← {% if articleType == 'news' %}{% if lang == 'fr' %}Actualités{% else %}News{% endif %}{% else %}Blog{% endif %}</a></div></div></section></main>
