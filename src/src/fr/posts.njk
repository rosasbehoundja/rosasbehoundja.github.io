---
layout: base.njk
title: Blog
pageKey: posts
permalink: /fr/posts/index.html
lang: fr
---
{% include "interior-header.njk" %}
<main id="main"><section class="hero section-shadow"><div class="hero-body"><div class="container is-max-desktop px-5">{% set year = 0 %}{% for post in collections.postsFr %}{% if post.date.getUTCFullYear() != year %}{% if not loop.first %}</div></div>{% endif %}<div class="columns"><div class="column is-2 pt-0"><div class="content"><p class="pub-year is-size-2 mb-0">{{ post.date | date('yyyy') }}</p></div></div><div class="column is-10 pt-0">{% set year = post.date.getUTCFullYear() %}{% endif %}<div class="columns is-mobile mt-3 mb-2"><div class="column is-11-tablet is-10-mobile pt-0 mt-0"><div class="content mt-0 talk-page"><h3 class="pub-title is-size-4 mb-1 mt-0"><a href="{{ post.url }}" style="color:inherit">{{ post.data.title }}</a></h3><div class="is-flex is-flex-wrap-wrap is-align-items-center mt-2 mb-3 is-size-7" style="gap:.75rem"><span class="has-text-grey"><i class="far fa-calendar-alt fa-fw pr-1"></i> {{ post.date | date('dd MMM yyyy') }}</span>{% if post.data.readingTime %}<span class="has-text-grey-lighter">•</span><span class="has-text-grey"><i class="far fa-clock fa-fw pr-1"></i> {{ post.data.readingTime }} min read</span>{% endif %}</div>{% if post.data.image %}<div class="mt-4 mb-0 ml-0 pl-0 talk-visual-wrapper"><figure class="image is-16-by-9 talk-figure"><a href="{{ post.url }}"><img src="{{ post.data.image }}" alt="" style="width:100%"></a></figure></div>{% endif %}<div class="pub-description mt-3 is-family-secondary has-text-grey-dark">{{ post.data.excerpt }}</div></div></div></div><div class="columns"><div class="column is-full-mobile is-11-tablet is-10-desktop"><div class="is-divider my-0 py-1 mt-3 mb-2" style="border-color:rgba(0,0,0,.05)"></div></div></div>{% else %}<p>Aucun article pour le moment.</p>{% endfor %}{% if collections.postsFr.length %}</div></div>{% endif %}</div></div></section></main>
