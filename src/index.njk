---
layout: base.njk
---
<section class="hero mt-6 section-shadow"><div class="hero-body pb-4"><div class="container is-max-desktop px-5 home-header">
  <h1 class="site-title title mb-2 is-uppercase">{{ site.name }}</h1>
  <div class="columns mt-0 is-mobile"><div class="column is-8 pt-0 mt-0">{% include "socials.njk" %}<div class="home-nav-desktop">{% include "nav.njk" %}</div></div><div class="column is-4 home-portrait-column"><figure class="image portrait profile-portrait"><img src="{{ site.portrait }}" alt="Portrait of {{ site.name }}"></figure></div></div>
  <div class="home-nav-mobile">{% include "nav.njk" %}</div>
</div></div></section>
<main id="main">
<section class="hero section-shadow"><div class="hero-body pb-0"><div class="container is-max-desktop px-5"><h5 class="tiny-section-header mb-6 mt-1" id="about">ABOUT</h5><div class="columns"><div class="column is-12 pt-0"><div class="content is-family-secondary has-text-black-ter">{{ researchContent | markdown | safe }}<ul>{% for direction in directions %}<li><strong>{{ direction.title }}</strong>: {{ direction.description }}</li>{% endfor %}</ul></div></div></div>
</div></div></section>
<section class="hero section-shadow"><div class="hero-body"><div class="container is-max-desktop px-5"><h5 class="tiny-section-header mb-6 mt-1" id="latest">LATEST</h5><div class="content"><div class="columns"><div class="column is-6 update-section"><div class="columns my-0 py-0 is-mobile is-multiline scrollable-update-section-columns">{% for update in collections.updates %}<div class="column my-0 py-0 is-full-desktop is-half-mobile"><div class="content py-2 px-3 mb-2 update-block {% if loop.first %}is-active{% endif %}" data-update-id="{{ update.fileSlug }}" data-update-type="{{ update.data.kind }}"><div class="is-family-secondary mt-1"><span class="is-size-7 has-text-grey-light">{{ update.date | date('yyyy MMMM') }}</span></div><div class="is-size-6 is-italic"><span class="{% if update.data.kind == 'career' %}update-tag-career{% elif update.data.kind == 'news' %}has-text-danger has-background-danger-light{% elif update.data.kind == 'talk' %}has-text-info has-background-info-light{% else %}has-text-success has-background-success-light{% endif %}">{{ update.data.label }}</span></div><h6 class="title is-family-secondary mb-2" style="line-height:145%">{{ update.data.title }}</h6></div></div>{% endfor %}</div></div><div class="column is-6">{% for update in collections.updates %}<div id="update-details-{{ update.fileSlug }}" class="update-details {% if not loop.first %}is-hidden{% endif %}">{% if update.data.image %}<figure class="image"><img src="{{ update.data.image }}" alt=""></figure>{% endif %}<div class="content is-family-secondary has-text-grey-dark mt-4">{{ update.content | safe }}</div></div>{% endfor %}</div></div></div></div></div></section>
<section class="hero section-shadow"><div class="hero-body"><div id="collapsibleSection" class="collapsible-section"><div class="container is-max-desktop px-5"><h5 class="tiny-section-header mb-6 mt-1" id="publications">RESEARCH</h5><div class="tabs pb-4 mb-1 is-centered" data-tab-group="publication"><ul><li class="is-active" data-tab-target="#posters"><a class="px-5">Posters</a></li><li data-tab-target="#papers"><a class="px-5">Papers</a></li><li data-tab-target="#presentations"><a class="px-5">Presentations</a></li></ul></div><div id="posters" class="tab-content is-active" data-tab-group="publication">{% set selected = collections.publications | filterPublicationType('poster') %}{% include "publication-list.njk" %}</div><div id="papers" class="tab-content" data-tab-group="publication">{% set selected = collections.publications | filterPublicationType('paper') %}{% include "publication-list.njk" %}</div><div id="presentations" class="tab-content" data-tab-group="publication">{% include "presentation-list.njk" %}</div></div></div></div><div class="has-text-centered"><button id="toggleButton" class="toggle-button show-more is-family-secondary" hidden>Show more</button></div></div></section>
</main>
