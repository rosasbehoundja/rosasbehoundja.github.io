{% set year = 0 %}{% for item in selected %}{% if item.data.year != year %}{% if not loop.first %}</div></div>{% endif %}<div class="columns publication-year-group"><div class="column is-2 publication-year-column"><div class="content"><p class="pub-year is-size-2">{{ item.data.year }}</p></div></div><div class="column is-10 publication-year-items">{% set year = item.data.year %}{% endif %}
<div class="columns is-mobile mt-0 mb-4 publication-entry-row"><div class="column publication-copy"><div class="content"><h3 class="pub-title is-size-4 mb-1">{% if item.data.url %}<a href="{{ item.data.url }}" style="color:inherit">{{ item.data.title }}</a>{% else %}{{ item.data.title }}{% endif %}{% if item.data.featured %}<span class="tag is-danger is-light is-size-7 publication-type-tag">Featured</span>{% endif %}</h3><div class="pub-links">{% for link in item.data.links %}<a href="{{ link.url }}" class="publication-link"><i class="{{ link.icon or 'fas fa-link' }} {{ link.iconColor or 'has-text-info' }}" aria-hidden="true"></i><span>{{ link.label }}</span></a>{% endfor %}</div><div class="pub-info mt-4"><div class="pub-author mb-0">{{ item.data.authors | safe }}</div>{% if item.data.type != "poster" and item.data.venue %}<div class="pub-venue">{{ item.data.venue }}</div>{% endif %}<div class="pub-description mt-2">{{ item.content | safe }}</div></div></div></div>{% if item.data.image %}<div class="column publication-logo-column"><figure class="image publication-logo"><img src="{{ item.data.image }}" alt="{{ item.data.imageAlt or item.data.venue or 'Publication venue logo' }}" loading="lazy"></figure></div>{% endif %}</div>
{% else %}<p>No publications yet.</p>{% endfor %}{% if selected.length %}</div></div>{% endif %}
