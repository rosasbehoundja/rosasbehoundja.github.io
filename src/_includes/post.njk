---
layout: base.njk
---
<header class="post-head">
  <div class="post-container">
    <h1 class="post-title title">{{ title }}</h1>
    <div class="post-meta">
      <time datetime="{{ page.date | date('yyyy-MM-dd') }}">{{ page.date | date('dd MMM yyyy') }}</time>
      {% if readingTime %}<span aria-hidden="true">·</span><span>{{ readingTime }} min</span>{% endif %}
      <span aria-hidden="true">·</span><a href="/">{{ site.shortName }}</a>
      {% if translationUrl %}<span aria-hidden="true">·</span><a href="{{ translationUrl }}" hreflang="{% if lang == 'fr' %}en{% else %}fr{% endif %}">{% if lang == 'fr' %}English{% else %}Français{% endif %}</a>{% endif %}
    </div>
  </div>
</header>
<main id="main" class="post-main">
  <article class="post-container content post-body">{{ content | safe }}</article>
  <nav class="post-container post-return" aria-label="{% if lang == 'fr' %}Retour{% else %}Back{% endif %}">
    <a href="{% if articleType == 'news' %}/#latest{% else %}/{% if lang == 'fr' %}fr/{% endif %}posts/{% endif %}">← {% if articleType == 'news' %}{% if lang == 'fr' %}Actualités{% else %}News{% endif %}{% else %}Blog{% endif %}</a>
  </nav>
</main>
